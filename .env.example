# PostgreSQL connection string (pooled). Used by Prisma at runtime.
DATABASE_URL="postgresql://user:password@localhost:5432/booknest"
# Direct (non-pooled) connection — used by Prisma for migrations.
DATABASE_DIRECT_URL="postgresql://user:password@localhost:5432/booknest"

# Google oAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub oAuth
GITHUB_ID=
GITHUB_SECRET=

# Next oAuth
NEXTAUTH_SECRET=

# App URL (used for OG image generation — set to your production domain)
NEXT_PUBLIC_APP_URL=https://your-domain.com